# Copy to .env and adjust. All values are optional (dev defaults shown).

# Postgres (required to harden in production):
POSTGRES_PASSWORD=change-me

# Host ports (defaults: HTTP 80, HTTPS 443):
# PUBLIC_HTTP_PORT=80
# PUBLIC_HTTPS_PORT=443
# HTTP_PORT=8080
# HTTPS_PORT=8443

# TLS (optional): off | letsencrypt | selfsigned | files
# TLS_MODE=off
# TLS_DOMAINS=vidsilos.example.com
# TLS_CERT_FILE=
# TLS_KEY_FILE=

# Resource caps (defaults: app 512m/1cpu, worker 4g/4cpu):
# APP_MEM_LIMIT=512m
# APP_CPUS=1
# WORKER_MEM_LIMIT=4g
# WORKER_CPUS=4

# MinIO (s3 profile only):
# MINIO_ROOT_PASSWORD=vidsilo-secret
