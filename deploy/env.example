# VOD environment example — copy to /etc/vod-app/env
# Only DATABASE_URL is required (plus S3_* when using the s3 driver).

# Postgres connection (required)
# Same-host installs (install.sh default): peer auth over the unix socket.
DATABASE_URL=postgres:///vod?host=/var/run/postgresql
# Remote app/worker nodes: TCP with the role password (install.sh --db-password).
# DATABASE_URL=postgres://vod:<password>@dbhost:5432/vod

# Media storage root (local driver); also holds secret.key and certs
DATA_DIR=/var/lib/vod-app/data

# Storage driver: local (default) or s3
STORAGE_DRIVER=local

# Secrets for the s3 driver only (never stored in the DB)
# S3_ENDPOINT=https://s3.amazonaws.com   # or MinIO URL
# S3_BUCKET=vod
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# Optional overrides
# PORT=8080
