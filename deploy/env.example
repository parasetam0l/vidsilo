# VOD environment example — copy to /etc/vod-app/env
# Only DATABASE_URL is required (plus S3_* when using the s3 driver).

# Postgres connection (required)
# Same-host installs (install.sh default): peer auth over the unix socket.
DATABASE_URL=postgres:///vod?host=/var/run/postgresql
# Remote app/worker nodes: TCP with the role password (install.sh --db-password).
# DATABASE_URL=postgres://vod:<password>@dbhost:5432/vod

# Media storage root (local driver); also holds secret.key and certs
DATA_DIR=/var/lib/vod-app/data

# Storage driver: local (default) or s3
STORAGE_DRIVER=local

# Secrets for the s3 driver only (never stored in the DB)
# S3_ENDPOINT=https://s3.amazonaws.com   # or MinIO URL
# S3_BUCKET=vod
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# Optional overrides
# HTTP_PORT=80          # plain-HTTP listener (bare-metal default 80; docker uses 8080)
# HTTPS_PORT=443        # TLS listener (bare-metal default 443; docker uses 8443)
# HTTPS_PUBLIC_PORT=443 # port used in HTTP->HTTPS redirect targets; set to
#                       # HTTPS_PORT when serving on a non-standard public port
# PORT=80               # deprecated alias for HTTP_PORT

# --- TLS (all optional) -----------------------------------------------------
# TLS_MODE: off (default, plain HTTP) | letsencrypt | selfsigned | files
#   letsencrypt — Let's Encrypt via autocert: HTTPS on :443, HTTP on PORT
#                 answers ACME challenges and redirects to https. Needs
#                 public DNS for TLS_DOMAINS and ports 80/443 reachable.
#   selfsigned  — HTTPS :443 with a locally generated certificate (created
#                 on first start, cached in TLS_CERT_DIR). No DNS needed.
#   files       — HTTPS :443 with your own TLS_CERT_FILE/TLS_KEY_FILE.
#                 If the files are missing or unreadable the server logs a
#                 warning and falls back to self-signed rather than refusing
#                 to start.
# TLS_MODE=off
# TLS_DOMAINS=vods.example.com,www.vods.example.com
# TLS_CERT_FILE=/etc/vod-app/tls/server.pem
# TLS_KEY_FILE=/etc/vod-app/tls/server-key.pem
# TLS_CERT_DIR=/var/lib/vod-app/certs   # default: $DATA_DIR/certs (certs + self-signed cache)
